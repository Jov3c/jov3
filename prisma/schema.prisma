generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntryTargetType {
  INTERNAL
  EXTERNAL
}

enum ProjectStatus {
  BUILDING
  ACTIVE
  DONE
  PAUSED
}

model AdminUser {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique @db.VarChar(254)
  passwordHash String         @map("password_hash")
  displayName  String         @map("display_name") @db.VarChar(80)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions     AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id         String    @id @default(uuid()) @db.Uuid
  adminId    String    @map("admin_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("admin_sessions")
}

model SiteProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  siteTitle          String   @map("site_title") @db.VarChar(120)
  siteDescription    String   @map("site_description") @db.VarChar(300)
  foundedAt          DateTime @map("founded_at") @db.Date
  publicContactEmail String?  @map("public_contact_email") @db.VarChar(254)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_profile")
}

model MediaAsset {
  id           String   @id @default(uuid()) @db.Uuid
  originalName String   @map("original_name") @db.VarChar(255)
  storedName   String   @unique @map("stored_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt   @map("size_bytes")
  width        Int?
  height       Int?
  storagePath  String   @unique @map("storage_path") @db.VarChar(500)
  publicUrl    String   @unique @map("public_url") @db.VarChar(500)
  sha256       String?  @db.Char(64)
  altText      String?  @map("alt_text") @db.VarChar(300)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  homeProfiles HomeProfile[]

  @@map("media_assets")
}

model EmailVerification {
  id          String    @id @default(uuid()) @db.Uuid
  purpose     String    @db.VarChar(40)
  entityId    String    @map("entity_id") @db.Uuid
  email       String    @db.VarChar(254)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@index([purpose, entityId])
  @@map("email_verifications")
}

model HomeProfile {
  id            String      @id @default(uuid()) @db.Uuid
  nickname      String      @db.VarChar(80)
  role          String      @db.VarChar(160)
  intro         String
  avatarMediaId String?     @map("avatar_media_id") @db.Uuid
  statusText    String?     @map("status_text") @db.VarChar(120)
  statusVisible Boolean     @default(true) @map("status_visible")
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  avatarMedia   MediaAsset? @relation(fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@map("home_profile")
}

model HomeEntry {
  id          String          @id @default(uuid()) @db.Uuid
  title       String          @db.VarChar(80)
  description String          @db.VarChar(180)
  icon        String?         @db.VarChar(80)
  url         String          @db.VarChar(500)
  targetType  EntryTargetType @default(INTERNAL) @map("target_type")
  openNewTab  Boolean         @default(false) @map("open_new_tab")
  sortOrder   Int             @default(0) @map("sort_order")
  visible     Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([visible, sortOrder])
  @@map("home_entries")
}

model SocialLink {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(80)
  icon      String?  @db.VarChar(80)
  url       String   @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  visible   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([visible, sortOrder])
  @@map("social_links")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique @db.VarChar(120)
  name           String        @db.VarChar(120)
  summary        String        @db.VarChar(400)
  status         ProjectStatus
  techStack      String[]      @map("tech_stack")
  githubUrl      String?       @map("github_url") @db.VarChar(500)
  demoUrl        String?       @map("demo_url") @db.VarChar(500)
  readmeMarkdown String        @map("readme_markdown")
  sortOrder      Int           @default(0) @map("sort_order")
  visible        Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([visible, sortOrder])
  @@map("projects")
}
