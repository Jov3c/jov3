{
  "name": "jov3-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts tests/unit",
    "test:watch": "vitest --config vitest.config.ts tests/unit",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "prisma:studio": "prisma studio --config prisma7.config.ts",
    "admin:bootstrap": "tsx prisma/seed.ts",
    "site:init": "tsx scripts/site-init.ts",
    "test:reset-browser-data": "tsx tests/fixtures/reset-browser-data.ts",
    "test:seed-browser-data": "tsx tests/fixtures/seed-browser-data.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "dotenv": "18.0.4",
    "marked": "18.0.14",
    "nodemailer": "10.0.12",
    "nuxt": "4.5.2",
    "pg": "8.23.0",
    "sanitize-html": "2.17.7",
    "vue": "3.5.43",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "vue-tsc": "3.2.5"
  }
}
