POSTGRES_DB=jov3
POSTGRES_USER=jov3
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://jov3:replace-with-a-long-random-password@postgres:5432/jov3?schema=public
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_DISPLAY_NAME=Jov3
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Jov3
SMTP_FROM_EMAIL=
PUBLIC_SITE_URL=https://localhost
# Set alternate values (for example, 8080 and 8443) when 80/443 are used by another local project.
JOV3_HTTP_PORT=80
JOV3_HTTPS_PORT=443
JOV3_DATA_ROOT=/srv/jov3/data
JOV3_TLS_ROOT=/srv/jov3/tls
